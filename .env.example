# Copy to a PANINI runtime .env (never put keys in a project folder).
# Cloud tier (optional: without it, everything runs on the local model)
OPENAI_API_KEY=your_openai_key_here

# Jev routing (optional: without it, routing uses the offline complexity estimate)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# Local tier (Ollama)
# PANINI_CLI_LOCAL=auto                        # off disables the local tier
# PANINI_CLI_LOCAL_MODEL=qwen2.5:3b-instruct   # any tool-capable model you have pulled
# PANINI_CLI_LOCAL_CTX=16384
# OLLAMA_HOST=http://127.0.0.1:11434

# Model selection
# PANINI_CLI_MODEL=auto                        # auto | local | gpt-4.1 | ollama/<name>
# PANINI_CLI_ROUTER_MODELS=gpt-5.6-luna:cheap:Fast edits,gpt-5.6-terra:balanced:Routine coding,gpt-5.6-sol:strong:Hard work
# PANINI_CLI_ROUTER_FALLBACK=gpt-5.6-terra

# Safety
# PANINI_CLI_APPROVAL_MODE=ask                 # read-only | ask | edits | auto
# PANINI_CLI_SANDBOX=native                    # none | native | codex | docker

# Cost and behaviour (all also settable in ~/.panini/config.toml)
# PANINI_CLI_BUDGET_USD=2.0                    # stop a session's priced cloud spend here
# PANINI_CLI_LOCAL_STRONG_MODEL=qwen2.5:7b-instruct-q4_K_M   # tried before the cloud when the small model fails
# PANINI_CLI_WEB_SEARCH=0                      # 1 offers OpenAI's hosted web search to cloud models
# PANINI_CLI_EXPLORE=1                         # 0 disables the local scout tool
# PANINI_CLI_CHECKPOINTS=1                     # 0 disables git turn checkpoints
# PANINI_CLI_AUTO_VERIFY=1                     # 0 disables the "run your checks" reminder
# PANINI_CLI_TRUST_READ_ONLY=1                 # 0 asks even for read-only commands
# PANINI_CLI_PROFILE=offline                   # profile from config.toml
